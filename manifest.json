{
  "manifest_version": 3,
  "name": "OAuth Batch Auto-Consent",
  "version": "1.1.0",
  "description": "Side panel: batch OAuth consent otomatis — pilih akun berurutan, centang izin, Continue, kumpulkan kode localhost, copy-paste ke OpenClaw. Punya Start/Stop trigger.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://oauth.sainskerta.net/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://accounts.google.com/*",
        "https://oauth.sainskerta.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "OAuth Batch Console",
    "default_icon": {}
  }
}
